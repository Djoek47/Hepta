{
  "name": "hepta",
  "private": true,
  "version": "0.1.0",
  "description": "Hepta Listen: a live listening engine and test bench. Hears who is speaking, follows the subject, notices when someone changes it, and knows when to answer.",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "typecheck": "for p in core resolve memory hepta pyramid; do npx tsc --noEmit -p packages/$p/tsconfig.json || exit 1; done && npx tsc --noEmit -p tsconfig.json",
    "hepta": "esbuild packages/hepta/run.ts --bundle --format=esm --platform=node --outfile=.hepta.mjs --log-level=error --alias:@intermenu/aiuic-core=./packages/core/src/index.ts --alias:@intermenu/aiuic-resolve=./packages/resolve/src/index.ts && node .hepta.mjs",
    "bench": "esbuild bench/bench.ts --bundle --format=esm --platform=node --packages=external --alias:@intermenu/aiuic-core=./packages/core/src/index.ts --alias:@intermenu/aiuic-resolve=./packages/resolve/src/index.ts --alias:@intermenu/aiuic-memory=./packages/memory/src/index.ts --alias:@intermenu/hepta/lines=./packages/hepta/src/lines.ts --alias:@intermenu/hepta=./packages/hepta/src/index.ts --alias:@intermenu/aiuic-pyramid=./packages/pyramid/src/index.ts --alias:@hepta/listen=./packages/listen/src/index.ts --outfile=.bench.mjs --log-level=error && node .bench.mjs",
    "listen": "esbuild tools/listen.ts --bundle --format=esm --platform=node --packages=external --alias:@intermenu/aiuic-core=./packages/core/src/index.ts --alias:@intermenu/aiuic-resolve=./packages/resolve/src/index.ts --alias:@intermenu/aiuic-memory=./packages/memory/src/index.ts --alias:@intermenu/hepta/lines=./packages/hepta/src/lines.ts --alias:@intermenu/hepta=./packages/hepta/src/index.ts --alias:@intermenu/aiuic-pyramid=./packages/pyramid/src/index.ts --alias:@hepta/listen=./packages/listen/src/index.ts --outfile=.listen.mjs --log-level=error && node .listen.mjs",
    "build:web": "esbuild apps/studio/web/app.ts --bundle --format=esm --platform=browser --target=es2022 --outfile=apps/studio/public/app.js --log-level=warning",
    "start": "npm run build:web && esbuild apps/studio/src/main.ts --bundle --format=esm --platform=node --packages=external --alias:@intermenu/aiuic-core=./packages/core/src/index.ts --alias:@intermenu/aiuic-resolve=./packages/resolve/src/index.ts --alias:@intermenu/aiuic-memory=./packages/memory/src/index.ts --alias:@intermenu/hepta/lines=./packages/hepta/src/lines.ts --alias:@intermenu/hepta=./packages/hepta/src/index.ts --alias:@intermenu/aiuic-pyramid=./packages/pyramid/src/index.ts --alias:@hepta/listen=./packages/listen/src/index.ts --outfile=.studio.mjs --log-level=error && node .studio.mjs",
    "bench:debug": "esbuild bench/debug.ts --bundle --format=esm --platform=node --packages=external --alias:@intermenu/aiuic-core=./packages/core/src/index.ts --alias:@intermenu/aiuic-resolve=./packages/resolve/src/index.ts --alias:@intermenu/aiuic-memory=./packages/memory/src/index.ts --alias:@intermenu/hepta/lines=./packages/hepta/src/lines.ts --alias:@intermenu/hepta=./packages/hepta/src/index.ts --alias:@intermenu/aiuic-pyramid=./packages/pyramid/src/index.ts --alias:@hepta/listen=./packages/listen/src/index.ts --outfile=.debug.mjs --log-level=error && node .debug.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.24.2",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.5.0",
    "ws": "^8.22.1"
  }
}
